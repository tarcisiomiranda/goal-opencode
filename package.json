{
  "name": "goal-opencode",
  "version": "1.0.0",
  "type": "module",
  "description": "Long-running /goal mode for OpenCode 2 with auto-continuation, completion detection and a goal sidebar widget",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "goal",
    "sidebar",
    "tui"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tarcisiomiranda/goal-opencode.git"
  },
  "homepage": "https://github.com/tarcisiomiranda/goal-opencode#readme",
  "bugs": {
    "url": "https://github.com/tarcisiomiranda/goal-opencode/issues"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.26",
    "@opencode/theme": "2.0.26",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "@types/bun": "^1.3.11",
    "@types/node": "^25.8.0",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3"
  }
}
